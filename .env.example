# Copy to .env and fill in. Never commit .env.
#   copy .env.example .env
#   # Linux: cp .env.example .env

# Terraform (azurerm 4.x needs it). Get it: az account show --query id -o tsv
ARM_SUBSCRIPTION_ID=

# Producer -> Kafka
# Local (docker compose): localhost:9092 + PLAINTEXT
# Event Hubs (week 2): evhns-megasale-dev.servicebus.windows.net:9093 + SASL_SSL
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=events

# Event Hubs only: connection string of the Send-only policy.
# Don't paste by hand: python scripts/fill_env.py (needs az login), --local to switch back.
EVENTHUBS_CONNECTION_STRING=''

# Grafana -> Azure SQL: app grafana-megasale-reader (db_datareader only, no Azure role).
# Only the machine running Grafana (Sơn's) needs the secret; it expires 2026-12-31.
# Another machine: app owner runs az ad app credential reset --id <client id> --append.
GRAFANA_SQL_TENANT_ID=2dff09ac-2b3b-4182-9953-2b548e0d0b39
GRAFANA_SQL_CLIENT_ID=2a04c428-0d95-49e5-8879-4a53713034c7
GRAFANA_SQL_CLIENT_SECRET=

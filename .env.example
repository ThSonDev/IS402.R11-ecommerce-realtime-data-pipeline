# Copy to .env and fill in. Never commit .env.
#   copy .env.example .env
#   # Linux: cp .env.example .env

# Terraform (azurerm 4.x needs it). Get it: az account show --query id -o tsv
ARM_SUBSCRIPTION_ID=

# Producer -> Kafka
# Local (docker compose): localhost:9092 + PLAINTEXT
# Event Hubs (week 2): evhns-megasale-dev.servicebus.windows.net:9093 + SASL_SSL
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=events

# Event Hubs only: connection string of the Send-only policy. Get it with az (see infra/README.md, week 2).
EVENTHUBS_CONNECTION_STRING=''

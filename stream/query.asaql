-- Read the Event Hubs stream once and fan out from this shared stream.
-- The same CTE is also the base for rules added in issues #61 and #62.
WITH ev AS (
    SELECT
        *,
        GetMetadataPropertyValue([events], '[EventHub].[EventEnqueuedUtcTime]') AS EventEnqueuedUtcTime,
        GetMetadataPropertyValue([events], '[EventHub].[EventProcessedUtcTime]') AS EventProcessedUtcTime
    FROM [events] TIMESTAMP BY event_time
),
kpi AS (
    SELECT
        System.Timestamp() AS window_end,
        channel,
        province_code,
        SUM(CASE WHEN event_type = 'view' THEN CAST(1 AS bigint) ELSE CAST(0 AS bigint) END) AS view_count,
        SUM(CASE WHEN event_type = 'cart' THEN CAST(1 AS bigint) ELSE CAST(0 AS bigint) END) AS cart_count,
        SUM(CASE WHEN event_type = 'purchase' THEN CAST(1 AS bigint) ELSE CAST(0 AS bigint) END) AS purchase_count,
        COUNT(DISTINCT order_id) AS order_count,
        SUM(CASE WHEN event_type = 'purchase' THEN CAST(price_vnd AS bigint) ELSE CAST(0 AS bigint) END) AS gmv_vnd
    FROM ev
    GROUP BY
        channel,
        province_code,
        TUMBLINGWINDOW(minute, 1)
),
-- Rule 1 (bot): one user with more than 10 distinct purchase orders in a minute.
-- Threshold is provisional (real baseline max is 7, bot scenario is 20/min); tuned in #72.
bot AS (
    SELECT
        System.Timestamp() AS alert_time,
        'bot' AS rule_name,
        'user' AS entity_type,
        CAST(user_id AS nvarchar(max)) AS entity_id,
        'orders_per_min' AS metric_name,
        CAST(COUNT(DISTINCT order_id) AS float) AS metric_value,
        CAST(10 AS float) AS threshold,
        CAST(NULL AS nvarchar(max)) AS event_id
    FROM ev
    WHERE event_type = 'purchase'
    GROUP BY user_id, TUMBLINGWINDOW(minute, 1)
    HAVING COUNT(DISTINCT order_id) > 10
),
-- Rule 2 (multi-account): several new accounts use the same device and voucher
-- in a 10-minute interval. Start at >3 accounts; tune after #68 precision/recall.
multi_account AS (
    SELECT
        System.Timestamp() AS alert_time,
        'multi_account' AS rule_name,
        'device' AS entity_type,
        CAST(device_id AS nvarchar(max)) AS entity_id,
        'new_accounts_per_device' AS metric_name,
        CAST(COUNT(DISTINCT user_id) AS float) AS metric_value,
        CAST(3 AS float) AS threshold,
        CAST(NULL AS nvarchar(max)) AS event_id
    FROM ev
    WHERE event_type = 'purchase'
        AND is_new_account = 1
        AND voucher_code IS NOT NULL
    GROUP BY
        device_id,
        voucher_code,
        HOPPINGWINDOW(minute, 10, 1)
    HAVING COUNT(DISTINCT user_id) > 3
),
-- Rule 3 (price mismatch): alert when the mean price is more than 50% below the
-- reference price for a product in a one-minute purchase window (selling at a loss).
price_glitch AS (
    SELECT
        System.Timestamp() AS alert_time,
        'price_glitch' AS rule_name,
        'product' AS entity_type,
        CAST(e.product_id AS nvarchar(max)) AS entity_id,
        'price_deviation_ratio' AS metric_name,
        CAST(AVG(
            (CAST(r.ref_price_vnd AS float) - CAST(e.price_vnd AS float))
            / CAST(r.ref_price_vnd AS float)
        ) AS float) AS metric_value,
        CAST(0.5 AS float) AS threshold,
        CAST(NULL AS nvarchar(max)) AS event_id
    FROM ev AS e
    JOIN price_list AS r
        ON CAST(e.product_id AS nvarchar(max)) = r.product_id
    WHERE e.event_type = 'purchase'
        AND e.price_vnd > 0
        AND CAST(r.ref_price_vnd AS float) > 0
    GROUP BY e.product_id, TUMBLINGWINDOW(minute, 1)
    HAVING AVG(
        (CAST(r.ref_price_vnd AS float) - CAST(e.price_vnd AS float))
        / CAST(r.ref_price_vnd AS float)
    ) > 0.5
),
-- Rule 4 (payment outage): keep one order-count point for every minute with
-- traffic, including minutes with views but no purchases (count = 0).
orders_per_minute AS (
    SELECT
        System.Timestamp() AS alert_time,
        COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN order_id ELSE NULL END) AS order_count
    FROM ev
    GROUP BY TUMBLINGWINDOW(minute, 1)
),
order_anomaly_scores AS (
    SELECT
        alert_time,
        order_count,
        -- Do not report model warm-up scores until ten prior minute samples exist.
        LAG(alert_time, 10) OVER (LIMIT DURATION(minute, 11)) AS history_start,
        -- Confidence 80, ten prior samples; test results may require tuning.
        AnomalyDetection_SpikeAndDip(CAST(order_count AS float), 80, 10, 'dips')
            OVER (LIMIT DURATION(minute, 10)) AS scores
    FROM orders_per_minute
),
payment_outage AS (
    SELECT
        alert_time,
        'payment_outage' AS rule_name,
        'system' AS entity_type,
        CAST(NULL AS nvarchar(max)) AS entity_id,
        'orders_per_minute' AS metric_name,
        CAST(order_count AS float) AS metric_value,
        -- Initial reference value for the alert display; IsAnomaly is the trigger.
        CAST(90 AS float) AS threshold,
        CAST(NULL AS nvarchar(max)) AS event_id
    FROM order_anomaly_scores
    WHERE history_start IS NOT NULL
        AND CAST(GetRecordPropertyValue(scores, 'IsAnomaly') AS bigint) = 1
),
-- All alert rules share the same 8-column output contract.
alerts AS (
    SELECT alert_time, rule_name, entity_type, entity_id, metric_name, metric_value, threshold, event_id
    FROM bot
    UNION
    SELECT alert_time, rule_name, entity_type, entity_id, metric_name, metric_value, threshold, event_id
    FROM multi_account
    UNION
    SELECT alert_time, rule_name, entity_type, entity_id, metric_name, metric_value, threshold, event_id
    FROM price_glitch
    UNION
    SELECT alert_time, rule_name, entity_type, entity_id, metric_name, metric_value, threshold, event_id
    FROM payment_outage
)

-- One shared KPI aggregation feeds the lake, SQL Database, and Power BI.
SELECT * INTO [kpi_1min] FROM kpi
SELECT * INTO [kpi_1min_sql] FROM kpi
SELECT * INTO [kpi_1min_powerbi] FROM kpi

SELECT * INTO [alerts_sql] FROM alerts
SELECT * INTO [alerts_function] FROM alerts

-- Pipeline latency is averaged per event-time minute.
SELECT
    System.Timestamp() AS window_end,
    COUNT(*) AS event_count,
    AVG(CAST(DATEDIFF(millisecond, CAST(sent_time AS datetime), EventEnqueuedUtcTime) AS float)) AS avg_producer_to_eventhub_ms,
    AVG(CAST(DATEDIFF(millisecond, EventEnqueuedUtcTime, EventProcessedUtcTime) AS float)) AS avg_eventhub_to_asa_ms,
    AVG(CAST(DATEDIFF(millisecond, CAST(sent_time AS datetime), EventProcessedUtcTime) AS float)) AS avg_end_to_end_ms
INTO [pipeline_latency]
FROM ev
GROUP BY TUMBLINGWINDOW(minute, 1)

-- Raw archive: every event as-is into the data lake (Parquet, by date/hour) for Synapse.
SELECT
    schema_version,
    event_id,
    event_type,
    event_time,
    original_time,
    sent_time,
    user_id,
    session_id,
    order_id,
    device_id,
    is_new_account,
    product_id,
    category_code,
    brand,
    price_vnd,
    channel,
    province_code,
    payment_method,
    voucher_code,
    is_fraud,
    scenario,
    is_late,
    EventEnqueuedUtcTime
INTO [raw_archive]
FROM ev;

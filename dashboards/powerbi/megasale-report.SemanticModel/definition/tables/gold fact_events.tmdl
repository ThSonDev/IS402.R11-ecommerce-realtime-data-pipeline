table 'gold fact_events'
	lineageTag: 0030f343-ff33-40b7-b8b2-b7f736926112

	measure GMV = CALCULATE(SUM('gold fact_events'[price_vnd]), 'gold fact_events'[event_type] = "purchase")
		formatString: #,0
		lineageTag: 8821e046-2b3a-4091-b1c6-b5aa7fd264cd

	measure Orders = CALCULATE(DISTINCTCOUNT('gold fact_events'[order_id]), 'gold fact_events'[event_type] = "purchase")
		formatString: 0
		lineageTag: 759ac446-bc3d-4080-83de-20324ee4e7b5

	measure AOV = DIVIDE([GMV], [Orders])
		formatString: #,0
		lineageTag: 29089759-924a-45aa-b27f-9c22e667e0e3

	measure 'Fraud Orders' = CALCULATE(DISTINCTCOUNT('gold fact_events'[order_id]), 'gold fact_events'[event_type] = "purchase", 'gold fact_events'[is_fraud] = TRUE())
		formatString: 0
		lineageTag: 4b080dff-b6d4-4c27-b35b-a68daeeb0f3b

	measure 'Fraud Order Rate' = DIVIDE([Fraud Orders], [Orders])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 159aabf4-7e62-4efd-b0f1-f7eda15b0bca

	measure 'Sessions Viewed' = CALCULATE(DISTINCTCOUNT('gold fact_events'[session_id]), 'gold fact_events'[event_type] = "view")
		formatString: 0
		lineageTag: 20584e21-5889-4e95-8d6c-18ad341c6f0d

	measure 'Sessions Purchased' = CALCULATE(DISTINCTCOUNT('gold fact_events'[session_id]), 'gold fact_events'[event_type] = "purchase")
		formatString: 0
		lineageTag: e084ebe6-a2f3-4505-8d0a-6b5059e2cc7c

	measure 'Conversion Rate' = DIVIDE([Sessions Purchased], [Sessions Viewed])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: aa26f4bc-874c-46bf-8adf-b33ff3c52bf3

	measure 'Late Events' = CALCULATE(COUNTROWS('gold fact_events'), 'gold fact_events'[is_late] = TRUE())
		formatString: 0
		lineageTag: d470819e-85e4-428f-976d-1b611aef0f9f

	measure 'Fraud Labeled Events' = CALCULATE(COUNTROWS('gold fact_events'), 'gold fact_events'[is_fraud] = TRUE(), 'gold fact_events'[scenario] = SELECTEDVALUE(Loai[Loai]))
		formatString: 0
		lineageTag: 9dac1dac-821a-4af9-bde2-14f79a8e51bc

	measure 'Rule Alerts' = CALCULATE(COUNTROWS(alerts), alerts[rule_name] = SELECTEDVALUE(Loai[Loai]))
		formatString: 0
		lineageTag: 19e6dc92-38ca-4c4c-b290-a64d6391892f

